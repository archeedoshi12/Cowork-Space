{
  "info": {
    "name": "CoWork Space Booking API",
    "description": "Complete API collection for Co-working Space Booking System.\n\n## Setup\n1. Import this collection into Postman\n2. Set `baseUrl` variable to `http://localhost:5000/api`\n3. Run **Auth > Login** first to auto-set the `accessToken` variable\n4. All protected endpoints use `{{accessToken}}` automatically\n\n## Test Credentials\n- Admin: `admin@cowork.com` / `admin123`\n- Member: `member@cowork.com` / `member123`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "spaceId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const data = pm.response.json().data;",
                "  pm.collectionVariables.set('accessToken', data.accessToken);",
                "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login (Member)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@cowork.com\",\n  \"password\": \"member123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const data = pm.response.json().data;",
                "  pm.collectionVariables.set('accessToken', data.accessToken);",
                "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cowork.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const data = pm.response.json().data;",
                "  pm.collectionVariables.set('accessToken', data.accessToken);",
                "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Spaces (Public)",
      "item": [
        {
          "name": "List All Spaces",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/spaces?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["spaces"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "type", "value": "desk", "disabled": true },
                { "key": "capacity", "value": "4", "disabled": true },
                { "key": "search", "value": "meeting", "disabled": true },
                { "key": "date", "value": "2025-07-15", "disabled": true }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const spaces = pm.response.json().data;",
                "  if (spaces.length > 0) pm.collectionVariables.set('spaceId', spaces[0]._id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get Space by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/spaces/{{spaceId}}"
          }
        },
        {
          "name": "Get Space Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/spaces/{{spaceId}}/availability?date=2025-07-15",
              "query": [{ "key": "date", "value": "2025-07-15" }]
            }
          }
        }
      ]
    },
    {
      "name": "Spaces (Admin)",
      "item": [
        {
          "name": "Create Space",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/spaces",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Hot Desk\",\n  \"type\": \"desk\",\n  \"capacity\": 1,\n  \"pricePerHour\": 8,\n  \"amenities\": [\"WiFi\", \"Monitor\"],\n  \"description\": \"A comfortable hot desk\"\n}"
            }
          }
        },
        {
          "name": "Update Space",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/spaces/{{spaceId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Space Name\",\n  \"type\": \"desk\",\n  \"capacity\": 1,\n  \"pricePerHour\": 12,\n  \"amenities\": [\"WiFi\", \"Monitor\", \"Locker\"]\n}"
            }
          }
        },
        {
          "name": "Delete (Deactivate) Space",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/spaces/{{spaceId}}"
          }
        }
      ]
    },
    {
      "name": "Bookings (Member)",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"date\": \"2025-07-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"notes\": \"Team standup meeting\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('bookingId', pm.response.json().data._id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/bookings/my?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Bookings (Admin)",
      "item": [
        {
          "name": "Get All Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/bookings?page=1&limit=10&status=pending",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending" },
                { "key": "date", "value": "2025-07-15", "disabled": true },
                { "key": "spaceId", "value": "{{spaceId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Approve Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminNote\": \"Approved. Enjoy your session!\"\n}"
            }
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminNote\": \"Space not available for this period.\"\n}"
            }
          }
        },
        {
          "name": "Create Maintenance Block",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/bookings/maintenance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"date\": \"2025-07-20\",\n  \"startTime\": \"08:00\",\n  \"endTime\": \"18:00\",\n  \"notes\": \"Deep cleaning and equipment maintenance\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
